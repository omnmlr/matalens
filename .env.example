# npm run dev uses a private .matalens/ directory by default.
# For a hosted pilot, configure all three before enabling intake.
# MATALENS_ENABLE_UPLOADS=1
# MATALENS_DATA_DIR=/absolute/private/persistent/matalens
# MATALENS_ORIGIN=https://your-matalens-domain.example
# MATALENS_PORT=3000
# MATALENS_HOST=127.0.0.1
# MATALENS_TRUST_LOOPBACK_PROXY=1

# Optional absolute path to an operator-managed reviewed story edition.
# MATALENS_NEWS_EDITION=/private/matalens-news/reviewed-edition.json

# Build-time option for the integrated political-learning frontend.
# VITE_STORY_PROVIDER=api
