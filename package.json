{
  "name": "matalens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/import-election-catalogue.mjs --check && npm run typecheck && vite build && node scripts/build-sw.mjs",
    "start": "node server/index.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.news.json",
    "test": "node --test tests/api.test.mjs tests/news.test.mjs tests/catalogue.test.mjs",
    "test:browser": "playwright test",
    "moderate": "node server/moderate.mjs",
    "data:import": "node scripts/import-election-catalogue.mjs",
    "data:check": "node scripts/import-election-catalogue.mjs --check",
    "news": "node server/news/cli.ts"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.2.0",
    "@fontsource/newsreader": "^5.3.0",
    "busboy": "^1.6.0",
    "express": "^5.1.0",
    "lucide-react": "^0.577.0",
    "parse5": "^7.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.58.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
